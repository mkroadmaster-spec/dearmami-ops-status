# 복사: cp config/secrets.env.example config/secrets.env  (git 에 커밋되지 않음)
# 채널 하나만 채워도 그 채널만 수집됨. 빈 채널은 자동 스킵.
CAFE24_OPS_MODE=live

# ── 공통 ─────────────────────────────────────────
# 비우면 로컬 SQLite(data/ops.db). 운영은 Neon 등 무료 Postgres URL
DATABASE_URL=

# ── STEP 1. 카페24 Admin API (매출·주문의 원천) ──
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 아래 둘은 scripts/cafe24_auth.py 가 발급. DB(app_kv)에 저장되면 비워도 됨
CAFE24_ACCESS_TOKEN=
CAFE24_REFRESH_TOKEN=
CAFE24_REDIRECT_URI=https://localhost

# ── STEP 2. GA4 (방문자·전환율) ──
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── STEP 3. Meta 광고 ──
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# ── STEP 4. 네이버 검색광고(SA) ──
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_ID=

# ── STEP 5. 네이버 오픈API (경쟁사 데이터랩) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── STEP 6. 카카오모먼트 ──
KAKAO_REST_API_KEY=            # developers.kakao.com 앱 키 > REST API 키
KAKAO_BUSINESS_SECRET=         # REST API 키 수정 > 클라이언트 시크릿 '비즈니스 인증' 줄 코드 (활성화 ON 이면 필수)
KAKAO_AD_ACCOUNT_ID=           # moment.kakao.com 광고계정 번호
# 토큰은 Actions 'kakao authorize url' → 'kakao token' 으로 발급되어 DB 에 저장·자동 갱신 (아래는 폴백)
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# ── STEP 7. Google Ads ──
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=          # Cloud Console OAuth 클라이언트(웹)
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=        # 광고계정 10자리(하이픈 없이)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=  # 관리자(MCC) 10자리
# 토큰은 Actions 'google authorize url' → 'google token' 으로 발급되어 DB 에 저장·자동 갱신 (아래는 폴백)
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=

# ── STEP 7-b. 크리테오 (developers.criteo.com, 무료) ──
CRITEO_CLIENT_ID=
CRITEO_CLIENT_SECRET=
CRITEO_ADVERTISER_ID=

# ── STEP 8. 알림(선택) — Slack / 텔레그램 (PC·모바일에서 브리핑+대시보드 링크 수신) ──
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=            # 알림 메시지의 '대시보드 열기' 버튼 링크 (Render 주소 또는 아티팩트 링크)

# ── 대시보드 비밀번호 (비우면 보호 없음). 서버 로그인 + 정적 스냅샷 암호화에 사용 ──
DASHBOARD_PASSWORD=
